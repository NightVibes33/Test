diff --git a/django/utils/http.py b/django/utils/http.py
--- a/django/utils/http.py
+++ b/django/utils/http.py
@@ -202,12 +202,32 @@ def split_header_value(value, sep=","):
-    """Yield stripped parts of an HTTP header value split by sep.
-
-    Use only with headers whose values are token lists (e.g. Vary,
-    Cache-Control). Do not use with headers that allow quoted strings in values
-    (e.g. Set-Cookie), as commas inside values will be used as separators.
-    """
-    for part in value.split(sep):
-        if stripped := part.strip():
-            yield stripped
+    """Yield stripped parts of an HTTP header value split by sep.
+
+    Separators inside quoted strings aren't treated as list delimiters.
+    """
+    if len(sep) != 1:
+        for part in value.split(sep):
+            if stripped := part.strip():
+                yield stripped
+        return
+
+    start = 0
+    in_quote = False
+    escaped = False
+    for index, char in enumerate(value):
+        if escaped:
+            escaped = False
+        elif in_quote and char == "\\":
+            escaped = True
+        elif char == '"':
+            in_quote = not in_quote
+        elif char == sep and not in_quote:
+            if stripped := value[start:index].strip():
+                yield stripped
+            start = index + 1
+
+    if stripped := value[start:].strip():
+        yield stripped
 
 
